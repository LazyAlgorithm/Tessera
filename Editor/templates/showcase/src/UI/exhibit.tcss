#screen { width: 100%; height: 100%; align-items: center; justify-content: center; background-color: #051020bb }
.card { width: 520; padding: 30; gap: 18; background-color: #132235; border-radius: 12; border-width: 1; border-color: #26c9ec }
.title { font-size: 25; color: #26c9ec }
.row { flex-direction: row; gap: 15 }
button { padding: 12; background-color: #28516d }
#value { height: 22; color: #26c9ec }
