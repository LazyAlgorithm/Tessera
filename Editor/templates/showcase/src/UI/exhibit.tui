<panel id="screen"><panel class="card"><text class="title">UI DOCUMENT EXHIBIT</text><text>This panel is a .tui document styled with .tcss.</text><text>Its bar binds to a component field. Buttons invoke component methods.</text><bar id="value" bind="value" /><panel class="row"><button onclick="OnLess">Decrease</button><button onclick="OnMore">Increase</button></panel><button onclick="OnClose">Close panel</button></panel></panel>