sequence length 7 framerate 30
track camera
	shot 0 "Shot Wide"
	shot 4 "Shot Boulder" blend 1.5 fov 45
track transform "Shot Wide"
	key 0 position -14 47 -18 rotation 18 38 0 ease linear
	key 5 position -6 45 -16 rotation 15 18 0
track transform "Shot Boulder"
	key 0 position -0.5 43.8 -5 rotation 12 38 0
track subtitle
	line 0.8 "Sandbox Guide" "This is the Sandbox." length 2.5
	line 4.2 "Sandbox Guide" "Try breaking the boulder." length 2.5
track fade color 0 0 0
	key 0 1
	key 1.2 0
track event
	event 7 IntroDone
