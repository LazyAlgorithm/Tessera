<panel id="screen" onload="OnOpen">
	<panel class="card">
		<text class="title">Sample Menu</text>
		<text class="hint">Built from UI/sample_menu.tui. Buttons call methods on SampleMenu.bf.</text>
		<panel class="row">
			<text>Name</text>
			<input bind="playerName" style="flex-grow: 1" />
		</panel>
		<panel class="row">
			<text>Volume</text>
			<bar id="volume" bind="volume" />
			<button onclick="OnQuieter">-</button>
			<button onclick="OnLouder">+</button>
		</panel>
		<button class="primary" onclick="OnPlay">Play</button>
		<button class="danger" onclick="OnClose">Close</button>
		<text id="status" class="hint">Waiting...</text>
	</panel>
</panel>
