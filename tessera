#!/usr/bin/env bash
# Starts the Tessera project launcher (building it first if needed).
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
launcher="$root/build/Debug_Linux64/TesseraLauncher/TesseraLauncher"
if [[ ! -x "$launcher" ]]; then
	"$root/build.sh"
fi
export TESSERA_ROOT="$root"
exec "$launcher" "$@"
